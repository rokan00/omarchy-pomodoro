{
  "schemaVersion": 1,
  "id": "mlhunter.pomodoro",
  "name": "Pomodoro",
  "version": "1.0.0",
  "author": "mlhunter",
  "description": "A bar-resident Pomodoro focus timer with configurable work/break/long-break durations and cycle counts. Runs a background countdown daemon and stays theme-compatible via Omarchy shell tokens.",
  "kinds": ["bar-widget", "overlay"],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "overlay": "Overlay.qml"
  },
  "barWidget": {
    "displayName": "Pomodoro",
    "description": "Focus timer with work/break cycles",
    "category": "Productivity",
    "allowMultiple": false,
    "icon": ""
  },
  "overlay": {
    "displayName": "Pomodoro",
    "description": "Pomodoro timer controls and settings",
    "category": "Productivity",
    "allowMultiple": false
  }
}
